{
  "extends": "./tsconfig.json",
  "exclude": [
    "node_modules",
    "test",
    "scripts",
    "dist",
    "**/*.spec.ts",
    "**/*.e2e-spec.ts",
    // Test helpers. Both patterns on purpose: the folder catches a group of
    // them, the suffix catches one dropped anywhere else. A single pattern is
    // one convention away from being bypassed.
    "**/__fixtures__/**",
    "**/*.fixture.ts"
  ]
}

{
  "name": "adh-shop-api",
  "version": "1.0.0",
  "private": true,
  "description": "Checkout API for the ADH Shop storefront: catalogue, card payments through a payment gateway, deliveries and stock. NestJS, hexagonal architecture, DynamoDB.",
  "keywords": [
    "nestjs",
    "hexagonal-architecture",
    "railway-oriented-programming",
    "dynamodb",
    "checkout",
    "payments"
  ],
  "homepage": "https://adh-api.alfredo-dominguez.dev/api/docs",
  "bugs": {
    "url": "https://github.com/alfredo0607/adh-shop-api/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alfredo0607/adh-shop-api.git"
  },
  "license": "MIT",
  "author": {
    "name": "Alfredo José Domínguez Hernández",
    "url": "https://github.com/alfredo0607"
  },
  "engines": {
    "node": "^24"
  },
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main.js",
    "seed": "ts-node scripts/seed.ts",
    "seed:local": "node --env-file=.env -r ts-node/register scripts/seed.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test:cov"
  },
  "dependencies": {
    "@aws-crypto/sha256-js": "^5.2.0",
    "@aws-sdk/client-dynamodb": "^3.700.0",
    "@aws-sdk/client-sqs": "^3.1141.0",
    "@aws-sdk/cloudfront-signer": "^3.1138.0",
    "@aws-sdk/credential-providers": "^3.1138.0",
    "@aws-sdk/lib-dynamodb": "^3.700.0",
    "@aws-sdk/util-dynamodb": "^3.996.9",
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/swagger": "^11.0.0",
    "@nestjs/throttler": "^6.0.0",
    "@smithy/protocol-http": "^5.6.2",
    "@smithy/signature-v4": "^5.7.3",
    "@smithy/types": "^4.19.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "compression": "^1.7.5",
    "helmet": "^8.0.0",
    "ioredis": "^6.0.0",
    "nestjs-pino": "^4.1.0",
    "pino-http": "^10.3.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.0",
    "@types/compression": "^1.7.5",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^24.19.0",
    "@types/supertest": "^6.0.2",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "express": "^5.2.1",
    "jest": "^29.7.0",
    "pino-pretty": "^13.0.0",
    "prettier": "^3.4.2",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0"
  }
}

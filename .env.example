# Copy to .env for local development. Never commit the copy.
# Deployed environments receive these from Parameter Store, not from a file.

NODE_ENV=development
PORT=3000
LOG_LEVEL=debug

# --- AWS -------------------------------------------------------------------
AWS_REGION=us-east-1
DYNAMODB_TABLE_NAME=adh-shop-local
# Set only when running against DynamoDB Local. Leave unset when deployed.
DYNAMODB_ENDPOINT=http://localhost:8000

# --- Payment gateway -------------------------------------------------------
# The base URL is configuration, never a constant: it differs per environment
# and the codebase must not carry knowledge of the vendor.
PAYMENT_API_URL=https://replace-me.example.com/v1
PAYMENT_PUBLIC_KEY=replace_me
PAYMENT_PRIVATE_KEY=replace_me
PAYMENT_INTEGRITY_SECRET=replace_me
PAYMENT_EVENTS_SECRET=replace_me
PAYMENT_TIMEOUT_MS=10000

# --- Pricing policy --------------------------------------------------------
# Integer cents. Never floating point: 0.1 + 0.2 !== 0.3.
BASE_FEE_IN_CENTS=50000
DELIVERY_FEE_IN_CENTS=120000
# Minutes a PENDING transaction holds its units before they return to stock
RESERVATION_TTL_MINUTES=15
# Seconds between runs that return expired reservations to stock; 0 disables
RESERVATION_SWEEP_INTERVAL_SECONDS=60

# --- Product images --------------------------------------------------------
# Images live in a private bucket behind CloudFront and are served only through
# URLs this API signs. All three are required in production; leave them unset
# locally and image keys are returned unsigned.
CDN_DOMAIN=
CDN_KEY_PAIR_ID=
# The PEM private key, base64-encoded (it is multi-line; an env file is not)
CDN_PRIVATE_KEY_BASE64=
# Minimum validity of an issued image URL, in seconds
IMAGE_URL_TTL_SECONDS=3600

# --- Rate limiting ---------------------------------------------------------
# Counters are shared through Redis so the limit applies across processes.
# Without REDIS_HOST the limiter falls back to in-process counters: correct for
# a single instance, and multiplied by the instance count beyond that.
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_USERNAME=
# ElastiCache requires TLS when authenticating with IAM. A local instance does not.
REDIS_TLS=false
REDIS_KEY_PREFIX=ratelimit:

# When the counter store is unreachable: true keeps serving unthrottled, false
# rejects. Failing open by default, because losing the cache should not take the
# storefront down.
RATE_LIMIT_FAIL_OPEN=true
RATE_LIMIT_BLOCK_MS=60000

# Proxy hops to trust when deriving the client address, which decides who gets
# rate limited. Too low and every caller shares one bucket, so one client can
# lock out everyone. Too high and a caller can forge X-Forwarded-For to evade
# the limiter. 0 for a direct connection; 2 behind Cloudflare and nginx.
TRUST_PROXY_HOPS=0

# --- HTTP ------------------------------------------------------------------
# Comma-separated origins allowed to call the API from a browser. The API has
# its own domain, so the storefront is always cross-origin; an empty list
# answers no preflight and the browser refuses every call.
CORS_ALLOWED_ORIGINS=http://localhost:5173
RATE_LIMIT_TTL_MS=60000
RATE_LIMIT_MAX=100

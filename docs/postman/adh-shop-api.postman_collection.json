    {
      "name": "Catalogue",
      "description": "Products with live stock and prices. Seeded; there is no endpoint to create them.",
      "item": [
        {
          "name": "List products",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 with a page of products', () => {",
                  "  pm.response.to.have.status(200);",
                  "  const page = pm.response.json();",
                  "  pm.expect(page.items).to.be.an('array').that.is.not.empty;",
                  "  pm.expect(page).to.have.property('nextCursor');",
                  "});",
                  "",
                  "// Remember a product that can be bought, for the checkout folder.",
                  "const buyable = pm.response.json().items.find((p) => p.isPurchasable && p.availableUnits > 0);",
                  "if (buyable && !pm.environment.get('productId')) pm.environment.set('productId', buyable.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/products?limit=20",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "products"],
              "query": [
                {
                  "key": "limit",
                  "value": "20"
                }
              ]
            },
            "description": "Cursor-paginated. Pass `nextCursor` from a page as `cursor` to read the next one. Image URLs are signed and expire."
          },
          "response": []
        },
        {
          "name": "Get a product",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 with stock and price', () => {",
                  "  pm.response.to.have.status(200);",
                  "  const product = pm.response.json();",
                  "  pm.expect(product.id).to.eql(pm.environment.get('productId'));",
                  "  pm.expect(product.availableUnits).to.be.a('number');",
                  "  pm.expect(product.priceInCents).to.be.a('number');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/products/{{productId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "products", "{{productId}}"]
            },
            "description": "One product with its current stock."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Checkout — happy path (run in order)",
      "description": "The whole purchase, as the storefront makes it. Run the folder with the Collection Runner, or request by request.\n\n1. Quote the order: product amount + base fee + delivery fee.\n2. Read the payment terms: the tokens the buyer accepts, and where to tokenise the card.\n3. Create the PENDING transaction: stock is reserved.\n4. Tokenise the card with the payment gateway, as the browser does. The card never reaches this API.\n5. Pay with an idempotency key; then pay again with the same key to see the replay.\n6. Poll the transaction until it is final; the runner repeats the request while it is PENDING.\n7. Read the delivery, assigned when the payment is approved.\n\nSet `cardNumber` in the environment: 4242424242424242 is approved, 4111111111111111 is declined.",
      "item": [
        {
          "name": "1. Quote the order",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 with the three amounts and the total', () => {",
                  "  pm.response.to.have.status(200);",
                  "  const { amounts } = pm.response.json();",
                  "  pm.expect(amounts.totalInCents).to.eql(amounts.productInCents + amounts.baseFeeInCents + amounts.deliveryFeeInCents);",
                  "  pm.environment.set('expectedTotalInCents', amounts.totalInCents);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/quotes?items={{productId}}:{{units}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "quotes"],
              "query": [
                {
                  "key": "items",
                  "value": "{{productId}}:{{units}}"
                }
              ]
            },
            "description": "Prices one or more products on the server (`id:units,id:units`). Reserves nothing."
          },
          "response": []
        },
        {
          "name": "2. Payment terms",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 with acceptance tokens and the tokenisation target', () => {",
                  "  pm.response.to.have.status(200);",
                  "  const terms = pm.response.json();",
                  "  pm.environment.set('acceptanceToken', terms.acceptance.token);",
                  "  pm.environment.set('personalDataAuthorizationToken', terms.personalDataAuthorization.token);",
                  "  pm.environment.set('publicKey', terms.publicKey);",
                  "  pm.environment.set('cardTokenizationUrl', terms.cardTokenizationUrl);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/payment-terms",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "payment-terms"]
            },
            "description": "The gateway's acceptance documents and tokens, its public key and the card tokenisation URL."
          },
          "response": []
        },
        {
          "name": "3. Create the transaction (PENDING)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 PENDING, with its Location', () => {",
                  "  pm.response.to.have.status(201);",
                  "  const transaction = pm.response.json();",
                  "  pm.expect(transaction.status).to.eql('PENDING');",
                  "  pm.expect(pm.response.headers.get('Location')).to.include(transaction.id);",
                  "  pm.environment.set('transactionId', transaction.id);",
                  "  pm.environment.unset('idempotencyKey');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"items\": [\n    {\n      \"productId\": \"{{productId}}\",\n      \"units\": {{units}}\n    }\n  ],\n  \"expectedTotalInCents\": {{expectedTotalInCents}},\n  \"customer\": {\n    \"fullName\": \"{{customerName}}\",\n    \"email\": \"{{customerEmail}}\",\n    \"phone\": \"+573001234567\"\n  },\n  \"deliveryAddress\": {\n    \"addressLine1\": \"Calle 93 # 11-26\",\n    \"addressLine2\": \"Apartamento 502\",\n    \"city\": \"Bogotá\",\n    \"region\": \"Cundinamarca\",\n    \"postalCode\": \"110221\",\n    \"country\": \"CO\"\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/transactions",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "transactions"]
            },
            "description": "Reserves the units of every product in one atomic write. `expectedTotalInCents` is the total the buyer saw; a different server total answers 422 AMOUNT_MISMATCH."
          },
          "response": []
        },
        {
          "name": "4. Tokenise the card (payment gateway)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 with a card token', () => {",
                  "  pm.response.to.have.status(201);",
                  "  pm.environment.set('cardToken', pm.response.json().data.id);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{publicKey}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"number\": \"{{cardNumber}}\",\n  \"cvc\": \"123\",\n  \"exp_month\": \"12\",\n  \"exp_year\": \"29\",\n  \"card_holder\": \"{{customerName}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{cardTokenizationUrl}}",
            "description": "Sent to the gateway, not to this API, with the gateway's public key. The storefront does this in the browser, so card data never reaches the API: only the token does."
          },
          "response": []
        },
        {
          "name": "5. Pay",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// One key per payment attempt; the next request reuses it to show the replay.",
                  "pm.environment.set('idempotencyKey', pm.variables.replaceIn('{{$guid}}'));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('202, payment submitted', () => {",
                  "  pm.response.to.have.status(202);",
                  "  pm.expect(pm.response.json().paymentSubmitted).to.eql(true);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{idempotencyKey}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"cardToken\": \"{{cardToken}}\",\n  \"installments\": 1,\n  \"acceptanceToken\": \"{{acceptanceToken}}\",\n  \"personalDataAuthorizationToken\": \"{{personalDataAuthorizationToken}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/transactions/{{transactionId}}/payment",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "transactions", "{{transactionId}}", "payment"]
            },
            "description": "Charges the card token through the gateway. Answers 202: the outcome is known later, by polling or by the webhook."
          },
          "response": []
        },
        {
          "name": "5b. Pay again with the same key (replayed)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('202 replayed, nothing charged twice', () => {",
                  "  pm.response.to.have.status(202);",
                  "  pm.expect(pm.response.headers.get('Idempotent-Replayed')).to.eql('true');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{idempotencyKey}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"cardToken\": \"{{cardToken}}\",\n  \"installments\": 1,\n  \"acceptanceToken\": \"{{acceptanceToken}}\",\n  \"personalDataAuthorizationToken\": \"{{personalDataAuthorizationToken}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/transactions/{{transactionId}}/payment",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "transactions", "{{transactionId}}", "payment"]
            },
            "description": "The same request under the same key returns the stored response instead of charging again, marked with `Idempotent-Replayed: true`."
          },
          "response": []
        },
        {
          "name": "6. Get the transaction (polls until final)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "const { status } = pm.response.json();",
                  "const attempts = Number(pm.environment.get('pollAttempts') || 0);",
                  "if (status === 'PENDING' && attempts < 15) {",
                  "  pm.environment.set('pollAttempts', attempts + 1);",
                  "  setTimeout(() => {}, 2000);",
                  "  pm.execution.setNextRequest(pm.info.requestName);",
                  "} else {",
                  "  pm.environment.unset('pollAttempts');",
                  "  pm.test(`final status: ${status}`, () => pm.expect(status).to.be.oneOf(['APPROVED', 'DECLINED', 'VOIDED', 'ERROR']));",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/transactions/{{transactionId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "transactions", "{{transactionId}}"]
            },
            "description": "While PENDING, this asks the gateway and settles the transaction: status, stock and delivery in one write. In the Collection Runner it repeats every 2 s, up to 15 times, until the status is final."
          },
          "response": []
        },
        {
          "name": "7. Get the delivery",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  pm.test('200 with the delivery', () => pm.expect(pm.response.json().status).to.eql('PREPARING'));",
                  "} else {",
                  "  pm.test('404: nothing to deliver for a refused payment', () => pm.response.to.have.status(404));",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/transactions/{{transactionId}}/delivery",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "transactions", "{{transactionId}}", "delivery"]
            },
            "description": "Assigned when the payment is approved: products, recipient, address and estimated date. 404 otherwise."
          },
          "response": []
        }
      ]
    },

{
  "info": {
    "_postman_id": "b3f1c2a4-6d1e-4f0b-9a57-3c2e8f4d1a60",
    "name": "ADH Shop API",
    "description": "Checkout API for the ADH Shop storefront: catalogue, quotes, transactions, card payments through a payment gateway (sandbox), deliveries and the gateway webhook.\n\nPick an environment (development or production) and run the folders in order. The checkout folder chains its requests through environment variables, so it runs end to end in the Collection Runner.\n\nSwagger UI: https://adh-api.alfredo-dominguez.dev/api/docs",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
